  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "worker": "node --import tsx scripts/worker.ts",
    "test:rls": "node --env-file=.env.local supabase/tests/rls.test.mjs",
    "test:constraints": "node --env-file=.env.local supabase/tests/constraints.test.mjs",
    "test:import": "node --env-file=.env.local --import tsx supabase/tests/import.test.mjs",
    "test:wording": "node --env-file=.env.local --import tsx supabase/tests/wording-operations.test.mjs",
    "test:comparison": "node --env-file=.env.local --import tsx supabase/tests/comparison.test.mjs",
    "test:standard-radio": "node --env-file=.env.local supabase/tests/standard-radio.test.mjs",
    "test:audio-matcher": "node --env-file=.env.local --import tsx supabase/tests/audio-matcher.test.mjs",
    "test:audio-metadata": "node --env-file=.env.local --import tsx supabase/tests/audio-metadata-waveform.test.mjs",
    "test:audio-upload": "node --env-file=.env.local --import tsx supabase/tests/audio-upload.test.mjs",
    "test:review-engine": "node --env-file=.env.local --import tsx supabase/tests/review-engine.test.mjs",
    "test:intelligence-engine": "node --env-file=.env.local --import tsx supabase/tests/intelligence-engine.test.mjs",
    "test": "pnpm run test:rls && pnpm run test:constraints && pnpm run test:standard-radio && pnpm run test:import && pnpm run test:wording && pnpm run test:comparison && pnpm run test:audio-matcher && pnpm run test:audio-metadata && pnpm run test:audio-upload && pnpm run test:review-engine && pnpm run test:intelligence-engine"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
